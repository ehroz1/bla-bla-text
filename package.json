{
  "name": "bla-bla-text",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-only audio & video transcription with your own free API keys — 11 speech-to-text services, tuned for mixed Russian/English and Kazakh.",
  "homepage": "https://ehroz1.github.io/bla-bla-text/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehroz1/bla-bla-text.git"
  },
  "bugs": {
    "url": "https://github.com/ehroz1/bla-bla-text/issues"
  },
  "keywords": [
    "speech-to-text",
    "transcription",
    "whisper",
    "subtitles",
    "srt",
    "russian",
    "kazakh",
    "code-switching",
    "browser",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:fixtures": "bash scripts/make-fixtures.sh tests/fixtures",
    "test:e2e": "node tests/e2e.mjs tests/fixtures"
  },
  "dependencies": {
    "@mediabunny/mp3-encoder": "^1.61.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "mediabunny": "^1.61.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.56.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
